{
  "name": "liquilens",
  "version": "0.5.0",
  "description": "LiquiLens Failure Radar in your terminal — live early-warning board for Indian institutions and FDIC-scored US banks, from public data",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://liquilens.in/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beepboop2025/liquilens-cli.git"
  },
  "bugs": {
    "url": "https://github.com/beepboop2025/liquilens-cli/issues"
  },
  "author": "beepboop2025",
  "keywords": [
    "cli",
    "tui",
    "finance",
    "risk",
    "early-warning",
    "bank-failure",
    "fdic",
    "rbi",
    "liquidity",
    "terminal-dashboard"
  ],
  "type": "module",
  "bin": {
    "liquilens": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/cli.js",
    "test": "tsc && node --test dist/cache.test.js dist/format.test.js dist/record.test.js dist/riskBands.test.js dist/us.test.js",
    "prepare": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
